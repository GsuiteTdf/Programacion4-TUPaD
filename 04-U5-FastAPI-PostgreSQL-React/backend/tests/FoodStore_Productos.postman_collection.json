{
  "info": {
    "_postman_id": "4df2b09a-60c6-4c6e-9c46-8a2ed6bc5e25",
    "name": "Food Store - Productos (TPI Unidad 5)",
    "description": "Colección de 13 casos para verificar CRUD, persistencia y errores 404/409/422 del Gestor de Productos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "idA",
      "value": ""
    },
    {
      "key": "idB",
      "value": ""
    },
    {
      "key": "nombreA",
      "value": ""
    },
    {
      "key": "nombreB",
      "value": ""
    },
    {
      "key": "nombreBDuplicado",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('nombreA')) {",
          "  const suffix = Date.now().toString();",
          "  pm.collectionVariables.set('nombreA', `Café molido ${suffix}`);",
          "  pm.collectionVariables.set('nombreB', `Té verde ${suffix}`);",
          "  pm.collectionVariables.set('nombreBDuplicado', `  TÉ VERDE ${suffix}  `);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Crear producto A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/productos/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{nombreA}}\",\n  \"descripcion\": \"Paquete de 500 g\",\n  \"precio\": 8500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('idA', String(data.id));",
              "pm.test('Devuelve id', () => pm.expect(data.id).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear producto B",
